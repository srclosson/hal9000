# Pick one provider. Unset LLM_PROVIDER = anthropic if ANTHROPIC_API_KEY is set, else scripted.

# Claude
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=low

# Any OpenAI-compatible endpoint (OpenAI, LiteLLM, Ollama, vLLM...)
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=

# Voice. Unset TTS_PROVIDER = comfyui if COMFYUI_URL is set, else browser (the eye's built-in speech).
# TTS_PROVIDER=comfyui
# COMFYUI_URL=https://comfyui.stackgen.run
# COMFYUI_TOKEN=

# Tools (MCP). JSON list; "tools" is an allowlist (omit it to allow only tools marked read-only).
# MCP_SERVERS=[{"name":"exa","url":"https://mcp.exa.ai/mcp?exaApiKey=...","tools":["web_search_exa","web_fetch_exa"]}]

# Speaking up when alerts fire (alerts/watch.js). On by default whenever Grafana alerting is connected.
# ALERT_WATCH=on
# ALERT_WATCH_SECONDS=30
# ALERT_MIN_SEVERITY=critical

# Quick calls (the opening call of each turn, background work): same model with low reasoning effort by default.
# LLM_FAST_MODEL=
# LLM_FAST_EFFORT=low

# Sign-in (auth.js). All four set = every page, the WebSocket and speech clips need a session. Unset = open (local dev).
# OIDC_ISSUER=https://auth.stackgen.run/application/o/hal9000/
# OIDC_CLIENT_ID=hal9000
# OIDC_CLIENT_SECRET=
# SESSION_SECRET=                      # any long random string (openssl rand -hex 32)
# PUBLIC_URL=https://9000.stackgen.run # where the identity provider sends people back to

# Observability: see docs/OBSERVABILITY.md. No collector configured = no telemetry network traffic.
# OTLP/HTTP JSON traces, metrics and logs. This is a BASE URL, not a gRPC endpoint.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
# OTEL_SERVICE_NAME=hal9000
# DEPLOYMENT_ENV=development
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20BASE64_USER_COLON_TOKEN
# Optional per-signal endpoint/header overrides (endpoints include /v1/<signal>):
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://collector:4318/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://collector:4318/v1/metrics
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://collector:4318/v1/logs
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1
# OTEL_SDK_DISABLED=true
# LOG_FORMAT=json                      # defaults to JSON when exporting logs; pretty otherwise

# Continuous wall/CPU and allocation profiles (native profiler is optional; separate from OTLP).
# PYROSCOPE_SERVER_ADDRESS=http://pyroscope:4040
# PYROSCOPE_APPLICATION_NAME=hal9000
# PYROSCOPE_BASIC_AUTH_USER=
# PYROSCOPE_BASIC_AUTH_PASSWORD=
# PYROSCOPE_AUTH_TOKEN=
# PYROSCOPE_ENABLED=false              # emergency off switch

# Faro: browser-accessible PUBLIC write-only RUM endpoint, NOT a backend OTLP URL or secret.
# Use Grafana Cloud's Frontend Observability collector URL, or Alloy's /collect endpoint.
# FARO_COLLECTOR_URL=https://faro.example.com/collect
# FARO_SESSION_SAMPLE_RATE=1           # 0..1; sessions are not persisted across browser restarts
